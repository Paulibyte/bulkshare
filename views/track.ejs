<%- include('partials/header') %>
<div class="panel" style="max-width:460px;margin:40px auto">
  <h1>Track my order</h1>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/track">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="c">Order reference</label><input type="text" id="c" name="code" placeholder="BS-XXXXXX" value="<%= codeVal %>" required>
    <label for="p">Phone number used</label><input type="tel" id="p" name="phone" value="<%= phoneVal %>" required>
    <button class="btn block" style="margin-top:16px">Find my order</button>
  </form>
</div>
<%- include('partials/footer') %>
