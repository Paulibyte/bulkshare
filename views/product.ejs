<%- include('partials/header') %>
<% const s = p.stats; const maxPick = Math.min(p.max_slots_per_customer, s.remaining); %>
<p class="small" style="margin-top:18px"><a href="/">Shop</a><% if (p.category_name) { %> › <a href="/category/<%= p.category_slug %>"><%= p.category_name %></a><% } %></p>
<div class="pgrid" style="margin-top:8px">
  <div>
    <div class="pimage"><% if (p.image) { %><img src="/static/uploads/<%= p.image %>" alt="<%= p.title %>"><% } else { %><img src="<%= brand.logo %>" alt="" style="width:34%;height:auto;object-fit:contain;opacity:.35"><% } %></div>
    <div class="panel" style="margin-top:18px">
      <div class="row"><h1 style="margin:0"><%= p.title %></h1><span class="badge b-<%= p.status %>"><%= p.status === 'closed' ? 'Full' : p.status %></span></div>
      <dl class="facts">
        <dt>Total price</dt><dd><%= naira(p.total_price) %></dd>
        <dt>Shared by</dt><dd><%= p.total_slots %> people</dd>
        <dt>One share costs</dt><dd style="color:var(--green)"><%= naira(p.slot_price) %></dd>
        <dt>Sharing day</dt><dd><%= fmtDate(p.sharing_date) %></dd>
        <dt>Sharing point</dt><dd><%= p.location_name || 'To be announced' %><% if (p.location_address) { %><br><span class="muted small" style="font-weight:400"><%= p.location_address %></span><% } %></dd>
        <dt>Options</dt><dd><%= [p.allow_pickup && 'Collect at the market', p.allow_delivery && 'Home delivery'].filter(Boolean).join(' · ') %></dd>
      </dl>
      <% if (p.description) { %><h3>About this item</h3><p class="desc"><%= p.description %></p><% } %>
      <% if (p.location_notes) { %><p class="small muted"><%= p.location_notes %></p><% } %>
      <% if (recent.length && settings.show_recent_joiners === '1') { %>
        <h3 style="margin-top:18px">Recently joined</h3>
        <ul class="joined"><% recent.forEach(r => { %><li><%= r.display.trim() %> · <%= r.slots %> share<%= r.slots > 1 ? 's' : '' %></li><% }) %></ul>
      <% } %>
    </div>
  </div>

  <aside class="panel" id="join">
    <h2 style="margin-bottom:4px">Who has paid</h2>
    <div class="bigcounts" style="<%= settings.show_reserved_count === '1' ? '' : 'grid-template-columns:1fr 1fr' %>">
      <div class="g"><b><%= s.paid %></b><span class="small">paid</span></div>
      <% if (settings.show_reserved_count === '1') { %><div class="a"><b><%= s.held %></b><span class="small">reserved</span></div><% } %>
      <div class="r"><b><%= s.remaining %></b><span class="small">left</span></div>
    </div>
    <%- include('partials/progress', { s, total: p.total_slots }) %>
    <p class="tiny muted" <%- settings.show_reserved_count === '1' ? '' : 'hidden' %>>"Reserved" shares are held for people who have started paying. If they don't complete payment in time, the share opens up again.</p>

    <% if (p.status !== 'open') { %>
      <div class="closedbox"><%= p.status === 'closed' ? 'All ' + p.total_slots + ' shares are paid for. Entry is closed.' : p.status === 'completed' ? 'This item has been shared. Thank you!' : 'This item is not taking contributors.' %></div>
    <% } else if (s.remaining === 0) { %>
      <div class="closedbox">All shares are currently reserved. Check back in a little while in case a reservation expires.</div>
    <% } else { %>
    <form method="post" action="/p/<%= p.slug %>/join" id="joinForm">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="slots">How many shares?</label>
      <select name="slots" id="slots">
        <% for (let i = 1; i <= maxPick; i++) { %><option value="<%= i %>" <%= String(form.slots) === String(i) ? 'selected' : '' %>><%= i %> share<%= i > 1 ? 's' : '' %> — <%= naira(i * p.slot_price) %></option><% } %>
      </select>
      <div class="two">
        <div><label for="n">Full name</label><input type="text" id="n" name="customer_name" required value="<%= form.customer_name || '' %>" autocomplete="name"></div>
        <div><label for="ph">Phone number</label><input type="tel" id="ph" name="phone" required value="<%= form.phone || '' %>" placeholder="080..." autocomplete="tel"></div>
      </div>
      <label for="em">Email <span class="muted small">(optional)</span></label>
      <input type="email" id="em" name="email" value="<%= form.email || '' %>" autocomplete="email">

      <label>How do you want to get your share?</label>
      <div class="opts">
        <% if (p.allow_pickup) { %><label class="opt"><input type="radio" name="fulfillment" value="pickup" <%= form.fulfillment !== 'delivery' ? 'checked' : '' %>><span>Collect at the sharing point<small><%= p.location_name || 'Market in Owerri' %> · <%= fmtDate(p.sharing_date) %></small></span></label><% } %>
        <% if (p.allow_delivery) { %><label class="opt"><input type="radio" name="fulfillment" value="delivery" <%= form.fulfillment === 'delivery' || !p.allow_pickup ? 'checked' : '' %>><span>Deliver to me<small>Delivery fee depends on your area</small></span></label><% } %>
      </div>
      <% if (p.allow_delivery) { %>
      <div id="deliv" style="display:none">
        <label for="area">Delivery area</label>
        <select name="delivery_area_id" id="area">
          <option value="">Choose area</option>
          <% areas.forEach(a => { %><option value="<%= a.id %>" data-fee="<%= a.fee %>" <%= String(form.delivery_area_id) === String(a.id) ? 'selected' : '' %>><%= a.name %> — <%= naira(a.fee) %></option><% }) %>
        </select>
        <label for="addr">Delivery address</label>
        <textarea name="delivery_address" id="addr" placeholder="House number, street, landmark"><%= form.delivery_address || '' %></textarea>
      </div>
      <% } %>

      <label>Payment method</label>
      <div class="opts">
        <label class="opt"><input type="radio" name="payment_method" value="bank" <%= form.payment_method !== 'opay' ? 'checked' : '' %>><span>Direct bank transfer<small>Transfer to our account, then upload your receipt</small></span></label>
        <% if (opayEnabled) { %><label class="opt"><input type="radio" name="payment_method" value="opay" <%= form.payment_method === 'opay' ? 'checked' : '' %>><span>Pay with OPay<small>Card, bank transfer, USSD or OPay wallet — confirmed instantly</small></span></label><% } %>
      </div>
      <div class="totalbox"><span>Total to pay</span><span id="total"><%= naira(p.slot_price) %></span></div>
      <button class="btn block">Reserve my share</button>
      <p class="tiny muted" style="margin-bottom:0">Your share is held while you pay. Entry closes automatically once all <%= p.total_slots %> shares are paid.</p>
    </form>
    <% } %>
    <a class="btn wa block" style="margin-top:14px" target="_blank" rel="noopener" href="https://wa.me/?text=<%= encodeURIComponent(`Join me to buy "${p.title}" in bulk! ${naira(p.slot_price)} per share, only ${s.remaining} shares left: ${shareUrl}`) %>">Share on WhatsApp</a>
  </aside>
</div>
<script>
(function(){
  const f = document.getElementById('joinForm'); if (!f) return;
  const price = <%= p.slot_price %>;
  const fmt = n => '₦' + n.toLocaleString('en-NG');
  const d = document.getElementById('deliv');
  function upd(){
    const slots = +f.slots.value;
    const isDel = (f.querySelector('input[name=fulfillment]:checked') || {}).value === 'delivery';
    if (d) d.style.display = isDel ? '' : 'none';
    const opt = f.delivery_area_id && f.delivery_area_id.selectedOptions[0];
    const fee = isDel && opt ? +(opt.dataset.fee || 0) : 0;
    document.getElementById('total').textContent = fmt(slots * price + fee) + (fee ? ' (incl. ' + fmt(fee) + ' delivery)' : '');
  }
  f.addEventListener('change', upd); upd();
})();
</script>
<%- include('partials/footer') %>
