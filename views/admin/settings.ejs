<%- include('../partials/header') %>
<h1>Settings &amp; customization</h1>
<nav class="settings-nav">
  <a class="chip" href="#branding">Logo &amp; favicon</a>
  <a class="chip" href="#colours">Colours</a>
  <a class="chip" href="#homepage">Homepage text</a>
  <a class="chip" href="#display">Display options</a>
  <a class="chip" href="#contact">Contact &amp; social</a>
  <a class="chip" href="#payments">Payments</a>
  <a class="chip" href="#password">Password</a>
</nav>

<form class="panel" method="post" action="/admin/settings" enctype="multipart/form-data" style="max-width:860px" id="settingsForm">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="section" value="all">

  <h2 id="branding">Logo &amp; favicon</h2>
  <label>Site name</label>
  <input type="text" name="site_name" value="<%= s.site_name %>" required>
  <label>Current logo</label>
  <div class="logo-preview">
    <img src="<%= brand.logo %>" alt="Logo" id="logoPreview">
    <div class="small muted"><%= s.logo ? 'Your uploaded logo' : 'Built-in logo' %></div>
    <% if (s.logo) { %><span class="spacer"></span><button class="btn sm ghost" name="reset_logo" value="1" onclick="return confirm('Go back to the built-in logo?')">Use built-in logo</button><% } %>
  </div>
  <label for="lf">Upload a new logo <span class="muted small">(PNG with transparent background works best · JPG/WebP also OK · max 5MB)</span></label>
  <input type="file" id="lf" name="logo_file" accept="image/png,image/jpeg,image/webp">
  <label class="check"><input type="checkbox" name="favicon_from_logo" value="1" checked> Also make the favicon (browser tab icon) from this logo</label>

  <label>Current favicon</label>
  <div class="logo-preview">
    <img src="<%= brand.fav.png192 %>" alt="Favicon" style="height:48px;width:48px">
    <img src="<%= brand.fav.png32 %>" alt="" style="height:16px;width:16px">
    <div class="small muted"><%= s.favicon ? 'Your uploaded favicon' : 'Built-in favicon' %></div>
    <% if (s.favicon) { %><span class="spacer"></span><button class="btn sm ghost" name="reset_favicon" value="1">Use built-in favicon</button><% } %>
  </div>
  <label for="ff">Upload a separate favicon <span class="muted small">(optional · a square image looks best)</span></label>
  <input type="file" id="ff" name="favicon_file" accept="image/png,image/jpeg,image/webp">

  <label>Header style</label>
  <div class="two">
    <label class="opt"><input type="radio" name="header_style" value="light" <%= s.header_style !== 'brand' ? 'checked' : '' %>><span>Light<small>White header bar — best for colourful logos</small></span></label>
    <label class="opt"><input type="radio" name="header_style" value="brand" <%= s.header_style === 'brand' ? 'checked' : '' %>><span>Brand colour<small>Header in your main colour, logo on a white tile</small></span></label>
  </div>
  <label class="check"><input type="checkbox" name="show_name_with_logo" value="1" <%= s.show_name_with_logo === '1' ? 'checked' : '' %>> Show the site name next to the logo</label>

  <h2 id="colours" class="section-title">Colours</h2>
  <p class="small muted">Buttons, progress bars and links use the main colour. Highlights and the announcement bar use the accent colour.</p>
  <div class="two">
    <% [['primary_color','Main colour'],['accent_color','Accent colour'],['bg_color','Page background']].forEach(([k, label]) => { %>
    <div>
      <label><%= label %></label>
      <div class="swatch"><input type="color" value="<%= s[k] %>" data-for="<%= k %>"><input type="text" name="<%= k %>" value="<%= s[k] %>" pattern="#[0-9a-fA-F]{6}"></div>
    </div>
    <% }) %>
  </div>
  <p class="small" style="margin-top:12px">Preview: <span class="btn sm">Main button</span> <span class="btn sm amber">Accent button</span> <span class="badge b-open">Open</span></p>
  <button class="btn sm ghost" name="reset_colors" value="1" onclick="return confirm('Reset to the default green and gold?')">Reset to default colours</button>

  <h2 id="homepage" class="section-title">Homepage text</h2>
  <label>Headline</label>
  <input type="text" name="hero_title" value="<%= s.hero_title %>">
  <label>Intro paragraph</label>
  <textarea name="hero_text" rows="3"><%= s.hero_text %></textarea>
  <label>Announcement bar <span class="muted small">(shows across the top of every page · leave empty to hide)</span></label>
  <input type="text" name="announcement" value="<%= s.announcement %>" placeholder="e.g. Christmas cow sharing: 19 Dec at Relief Market — 12 shares left!">
  <label>Button text on item cards</label>
  <input type="text" name="button_label" value="<%= s.button_label %>" placeholder="Join this share">
  <label>Short tagline <span class="muted small">(used when the headline is empty)</span></label>
  <input type="text" name="tagline" value="<%= s.tagline %>">
  <label>Description for Google &amp; link previews</label>
  <input type="text" name="meta_description" value="<%= s.meta_description %>">

  <h2 id="display" class="section-title">Display options</h2>
  <label class="check"><input type="checkbox" name="show_reserved_count" value="1" <%= s.show_reserved_count === '1' ? 'checked' : '' %>> Show the "reserved" count on item pages (people who started paying)</label>
  <label class="check"><input type="checkbox" name="show_recent_joiners" value="1" <%= s.show_recent_joiners === '1' ? 'checked' : '' %>> Show "Recently joined" names (first name + initial) on item pages</label>
  <div class="two">
    <div><label>Bank transfer: hold an unpaid share for (hours)</label><input type="number" step="0.5" min="0.5" name="bank_hold_hours" value="<%= s.bank_hold_hours %>"></div>
    <div><label>OPay: hold an unpaid share for (minutes)</label><input type="number" min="10" name="opay_hold_minutes" value="<%= s.opay_hold_minutes %>"></div>
  </div>
  <p class="tiny muted">Once a customer uploads a transfer receipt, their share stays held until you confirm or reject it.</p>

  <h2 id="contact" class="section-title">Contact &amp; social</h2>
  <div class="two">
    <div><label>Support phone</label><input type="tel" name="support_phone" value="<%= s.support_phone %>"></div>
    <div><label>WhatsApp number</label><input type="tel" name="whatsapp" value="<%= s.whatsapp %>" placeholder="2348012345678"></div>
    <div><label>Email</label><input type="email" name="contact_email" value="<%= s.contact_email %>"></div>
    <div><label>Footer line</label><input type="text" name="footer_text" value="<%= s.footer_text %>" placeholder="Owerri, Imo State"></div>
  </div>
  <label>Office address <span class="muted small">(optional)</span></label>
  <input type="text" name="address" value="<%= s.address %>">
  <div class="two">
    <div><label>Facebook link</label><input type="text" name="facebook" value="<%= s.facebook %>" placeholder="facebook.com/yourpage"></div>
    <div><label>Instagram link</label><input type="text" name="instagram" value="<%= s.instagram %>" placeholder="instagram.com/yourpage"></div>
    <div><label>TikTok link</label><input type="text" name="tiktok" value="<%= s.tiktok %>" placeholder="tiktok.com/@yourpage"></div>
  </div>

  <h2 id="payments" class="section-title">Payments</h2>
  <h3>Bank transfer</h3>
  <label>Bank name</label><input type="text" name="bank_name" value="<%= s.bank_name %>">
  <div class="two">
    <div><label>Account number</label><input type="text" name="account_number" value="<%= s.account_number %>" inputmode="numeric"></div>
    <div><label>Account name</label><input type="text" name="account_name" value="<%= s.account_name %>"></div>
  </div>
  <h3 style="margin-top:18px">OPay</h3>
  <p class="small">Status: <b><%= opayEnabled ? 'Connected (keys set)' : 'Off' %></b></p>
  <p class="small muted">OPay keys are kept in the server's <code>.env</code> file for safety: <code>OPAY_MERCHANT_ID</code>, <code>OPAY_PUBLIC_KEY</code>, <code>OPAY_SECRET_KEY</code> and <code>OPAY_BASE_URL</code>. Restart the app after changing them (<code>pm2 restart bulkshare --update-env</code>).</p>

  <div style="position:sticky;bottom:0;background:#fff;padding:14px 0 4px;margin-top:18px;border-top:1px solid var(--line)">
    <button class="btn">Save all settings</button>
  </div>
</form>

<form class="panel" id="password" method="post" action="/admin/password" style="max-width:860px;margin:22px 0 40px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Change admin password</h2>
  <div class="two">
    <div><label>Current password</label><input type="password" name="current" required autocomplete="current-password"></div>
    <div><label>New password</label><input type="password" name="next" minlength="8" required autocomplete="new-password"></div>
  </div>
  <button class="btn" style="margin-top:12px">Change password</button>
</form>

<script>
// live colour preview + keep colour picker and hex box in sync
const varFor = { primary_color: '--green', accent_color: '--amber', bg_color: '--bg' };
document.querySelectorAll('.swatch').forEach(w => {
  const pick = w.querySelector('input[type=color]'), txt = w.querySelector('input[type=text]');
  const apply = v => { if (/^#[0-9a-f]{6}$/i.test(v)) document.documentElement.style.setProperty(varFor[pick.dataset.for], v); };
  pick.addEventListener('input', () => { txt.value = pick.value; apply(pick.value); });
  txt.addEventListener('input', () => { if (/^#[0-9a-f]{6}$/i.test(txt.value)) pick.value = txt.value; apply(txt.value); });
});
// preview a chosen logo before saving
document.getElementById('lf').addEventListener('change', e => {
  const f = e.target.files[0]; if (f) document.getElementById('logoPreview').src = URL.createObjectURL(f);
});
</script>
<%- include('../partials/footer') %>
