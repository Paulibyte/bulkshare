<%- include('../partials/header') %>
<h1>Settings</h1>
<div class="pgrid">
<form class="panel" method="post" action="/admin/settings">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Shop</h2>
  <label>Site name</label><input type="text" name="site_name" value="<%= s.site_name %>">
  <label>Tagline</label><input type="text" name="tagline" value="<%= s.tagline %>">
  <div class="two">
    <div><label>Support phone</label><input type="tel" name="support_phone" value="<%= s.support_phone %>"></div>
    <div><label>WhatsApp number</label><input type="tel" name="whatsapp" value="<%= s.whatsapp %>" placeholder="2348012345678"></div>
  </div>
  <h2 style="margin-top:22px">Bank transfer details</h2>
  <label>Bank name</label><input type="text" name="bank_name" value="<%= s.bank_name %>">
  <div class="two">
    <div><label>Account number</label><input type="text" name="account_number" value="<%= s.account_number %>" inputmode="numeric"></div>
    <div><label>Account name</label><input type="text" name="account_name" value="<%= s.account_name %>"></div>
  </div>
  <h2 style="margin-top:22px">Reservation hold times</h2>
  <div class="two">
    <div><label>Bank transfer: hold unpaid share for (hours)</label><input type="number" step="0.5" min="0.5" name="bank_hold_hours" value="<%= s.bank_hold_hours %>"></div>
    <div><label>OPay: hold unpaid share for (minutes)</label><input type="number" min="10" name="opay_hold_minutes" value="<%= s.opay_hold_minutes %>"></div>
  </div>
  <p class="tiny muted">Once a customer uploads a transfer receipt, their share stays held until you confirm or reject it.</p>
  <button class="btn" style="margin-top:12px">Save settings</button>
</form>
<div>
  <div class="panel">
    <h2>OPay</h2>
    <p class="small">Status: <b><%= opayEnabled ? 'Connected (keys set)' : 'Off' %></b></p>
    <p class="small muted">OPay keys are kept in the server's <code>.env</code> file, not here: <code>OPAY_MERCHANT_ID</code>, <code>OPAY_PUBLIC_KEY</code>, <code>OPAY_SECRET_KEY</code>, and <code>OPAY_BASE_URL</code> (sandbox or live). Restart the app after changing them.</p>
  </div>
  <form class="panel" method="post" action="/admin/password" style="margin-top:18px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2>Change password</h2>
    <label>Current password</label><input type="password" name="current" required autocomplete="current-password">
    <label>New password</label><input type="password" name="next" minlength="8" required autocomplete="new-password">
    <button class="btn" style="margin-top:12px">Change password</button>
  </form>
</div>
</div>
<%- include('../partials/footer') %>
