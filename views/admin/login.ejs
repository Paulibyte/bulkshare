<%- include('../partials/header') %>
<div class="panel" style="max-width:420px;margin:50px auto">
  <h1>Admin login</h1>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/admin/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="e">Email</label><input type="email" id="e" name="email" required autocomplete="username">
    <label for="pw">Password</label><input type="password" id="pw" name="password" required autocomplete="current-password">
    <button class="btn block" style="margin-top:16px">Log in</button>
  </form>
</div>
<%- include('../partials/footer') %>
