# Copy to .env and fill in
PORT=3060
BASE_URL=https://share.bulktins.com        # public address of this app (used for OPay return/callback links)
SESSION_SECRET=put-a-long-random-string-here
COOKIE_SECURE=true                          # true when served over https

# First admin login (only used the very first time the app starts)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# OPay Checkout — get these from your OPay merchant dashboard
# Sandbox: https://testapi.opaycheckout.com   Live: https://liveapi.opaycheckout.com
OPAY_BASE_URL=https://testapi.opaycheckout.com
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
